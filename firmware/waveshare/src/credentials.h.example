#pragma once

// ESP32-S3 Wi-Fi is 2.4 GHz only. This file is ignored by Git, but these
// values are compiled into firmware, so do not distribute personal binaries.
#define CODEX_REMOTE_WIFI_SSID "your-wifi"
#define CODEX_REMOTE_WIFI_PASSWORD "your-password"

// New devices pair from the agent picker and store host credentials in NVS.
// OpenAI API keys belong in the Mac host's .env.local, never in this file.

// Leave the host empty to discover `_codex-remote._tcp` over mDNS.
#define CODEX_REMOTE_SERVER_HOST ""
#define CODEX_REMOTE_SERVER_PORT 47776
