{
  "name": "codex-remote",
  "version": "0.1.0",
  "private": true,
  "author": "Nicolas Bonamy",
  "description": "A pocket remote for local Codex threads, with an Electron host and ESP32-S3 client.",
  "type": "module",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "vite --mode electron",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run build && node scripts/package-macos.mjs",
    "verify:mac": "node scripts/verify-macos-release.mjs",
    "firmware:build": "pio run -d firmware/waveshare",
    "firmware:upload": "npm run firmware:upload:v2",
    "firmware:upload:v1": "pio run -d firmware/waveshare -e waveshare-esp32-s3-touch-amoled-1_8-v1 -t upload",
    "firmware:upload:v2": "pio run -d firmware/waveshare -e waveshare-esp32-s3-touch-amoled-1_8-v2 -t upload",
    "firmware:monitor": "pio device monitor -b 115200"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "codex-app-sdk": "file:../codex-app-sdk",
    "vue": "^3.5.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "dev.bonamy.codexremote",
    "productName": "Codex Remote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-main/**",
      "dist-renderer/**",
      "node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/codex-app-sdk/assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Codex-Remote-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Codex Remote uses the microphone for push-to-talk Codex commands.",
        "NSSpeechRecognitionUsageDescription": "Codex Remote transcribes push-to-talk audio into Codex commands."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  }
}
