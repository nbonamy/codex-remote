# Optional. Used only for OpenAI TTS read-aloud in existing Codex threads.
# Leave empty on macOS to use Apple speech. Voice Chat uses app-server realtime.
OPENAI_API_KEY=

# Optional OpenAI speech overrides.
CODEX_REMOTE_TTS_MODEL=gpt-4o-mini-tts
CODEX_REMOTE_TTS_VOICE=marin
CODEX_REMOTE_TTS_INSTRUCTIONS=Speak naturally in English with a warm, conversational tone, clear pacing, and subtle expression.
CODEX_REMOTE_REALTIME_VOICE=

# Optional host overrides.
CODEX_REMOTE_PORT=47776
